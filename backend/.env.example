NODE_ENV=development
PORT=3001

# Banco de dados — "postgres" ou "mysql"
DB_DIALECT=postgres
DB_HOST=localhost
# Opcional: se omitido, assume a porta padrão do DB_DIALECT (5432/3306)
# DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio
JWT_EXPIRES_IN=1d

# CORS
FRONTEND_URL=http://localhost:5173
